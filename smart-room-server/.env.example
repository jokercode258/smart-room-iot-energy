# Copy file này thành ".env" rồi điền thông tin thật vào.

# ---------- MQTT nội bộ (Node biên <-> ESP32 Wokwi) ----------
LOCAL_MQTT_URL=mqtt://broker.emqx.io

# ---------- MQTT "Cloud" (HiveMQ chạy bằng Docker) ----------
# Node biên + Cloud server kết nối qua TCP 1883
CLOUD_MQTT_URL=mqtt://localhost:1883
# Container đang bật HIVEMQ_ALLOW_ALL_CLIENTS=true nên không cần tài khoản
HIVEMQ_USER=
HIVEMQ_PASS=
# Dashboard (trình duyệt) kết nối qua WebSocket cổng 8000.
# Để trống thì tự dùng ws://<máy đang mở trang>:8000/mqtt (chạy được cả trên điện thoại)
DASH_MQTT_WS_URL=
DASH_MQTT_USER=
DASH_MQTT_PASS=

# ---------- MongoDB Atlas ----------
# Lấy ở Atlas > Database > Connect > Drivers
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=smartroom

# ---------- Tham số ----------
ROOM_ID=A101
# Chu kỳ Node biên gửi dữ liệu lên cloud (ms). Kịch bản thật: 300000 (5 phút). Demo: 10000.
UPLINK_INTERVAL_MS=10000
# Số giây phòng trống liên tục trước khi tự ngắt điện (luồng B, phải < 30s phản hồi)
EMPTY_TIMEOUT_S=10
# Ngưỡng quá tải (W) - luồng C
OVERLOAD_W=2000
# Số ngày giữ dữ liệu trên Atlas
RETENTION_DAYS=30
CLOUD_PORT=4000
